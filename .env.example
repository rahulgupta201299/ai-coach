# Copy this file to .env.local and fill in ONE provider below.

# =========================================================
# Which AI provider to use:
#   anthropic = Claude (paid; needs credits at console.anthropic.com)
#   openai    = any OpenAI-compatible API, incl. FREE tiers (Groq, Gemini, OpenRouter)
# =========================================================
AI_PROVIDER=openai

# ---------- Option A: FREE via Groq (recommended free option) ----------
# Key: https://console.groq.com/keys  (no credit card needed)
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=openai/gpt-oss-120b

# ---------- Option B: FREE via Google Gemini ----------
# Key: https://aistudio.google.com/apikey  (copy the exact model ID shown in AI Studio)
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OPENAI_API_KEY=AIzaxxxxxxxxxxxxxxxx
# OPENAI_MODEL=<a Flash model ID from AI Studio>

# ---------- Option C: FREE models via OpenRouter ----------
# Key: https://openrouter.ai/keys  (use a model ID ending in :free)
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-xxxxxxxxxxxxxxxx
# OPENAI_MODEL=openrouter/free

# ---------- Claude (paid) — set AI_PROVIDER=anthropic to use ----------
# Key: https://console.anthropic.com/settings/keys (starts with sk-ant-api03-), add credits under Billing
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-opus-5-5
# Effort level: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium

# =========================================================
# Password for the /admin page where the coach edits the knowledge base & instructions.
ADMIN_PASSWORD=change-me

# Shown in the chat header
NEXT_PUBLIC_COACH_NAME=Coach Meera
NEXT_PUBLIC_BRAND_NAME=Clarity Coaching
